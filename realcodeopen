-- 4. Gráficos Ultra Realistas para Tablet Pro
local activeAtmosphere, activeCorrection, activeBloom = nil, nil, nil

local function enableGodGraphics()
    pcall(function()
        if activeAtmosphere then activeAtmosphere:Destroy() end
        if activeCorrection then activeCorrection:Destroy() end
        if activeBloom then activeBloom:Destroy() end

        activeAtmosphere = Instance.new("Atmosphere")
        activeAtmosphere.Name = "GodAtmos"
        activeAtmosphere.Density = 0.55
        activeAtmosphere.Color = Color3.fromRGB(220, 10, 10)
        activeAtmosphere.Decay = Color3.fromRGB(40, 0, 0)
        activeAtmosphere.Parent = Lighting

        activeCorrection = Instance.new("ColorCorrectionEffect")
        activeCorrection.Name = "GodCorr"
        activeCorrection.TintColor = Color3.fromRGB(255, 40, 40)
        activeCorrection.Brightness = -0.04
        activeCorrection.Contrast = 0.5
        activeCorrection.Parent = Lighting

        activeBloom = Instance.new("BloomEffect")
        activeBloom.Name = "GodBloom"
        activeBloom.Intensity = 1.4
        activeBloom.Size = 40
        activeBloom.Threshold = 0.55
        activeBloom.Parent = Lighting
    end)
end

local function disableGodGraphics()
    pcall(function()
        if activeAtmosphere then activeAtmosphere:Destroy() end
        if activeCorrection then activeCorrection:Destroy() end
        if activeBloom then activeBloom:Destroy() end
        activeAtmosphere, activeCorrection, activeBloom = nil, nil, nil
    end)
end

local insideRealm = false
local originalCFrame = nil
local activeState = false
local activeVortex = nil
local spinGuiConn = nil
local vortexFlingConn = nil

local function executeKamui()
    if activeState then return end
    activeState = true

    TweenService:Create(KamuiButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 95, 0, 95)
    }):Play()
    task.wait(0.1)
    TweenService:Create(KamuiButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 110, 0, 110)
    }):Play()

    local char = lp.Character
    if not char then activeState = false return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then activeState = false return end

    if not insideRealm then
        originalCFrame = root.CFrame
    end

    -- 1. Sonido, atmósfera carmesí y Mangekyo gigante
    pcall(function()
        KamuiSound.TimePosition = 0
        KamuiSound:Play()
    end)
    enableGodGraphics()

    KamuiRing.Visible = true
    KamuiRing.Size = UDim2.new(0, 0, 0, 0)
    KamuiRing.Rotation = 0

    TweenService:Create(KamuiRing, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 750, 0, 750)
    }):Play()

    if spinGuiConn then spinGuiConn:Disconnect() end
    spinGuiConn = RunService.RenderStepped:Connect(function()
        if KamuiRing.Visible then
            KamuiRing.Rotation = KamuiRing.Rotation + 40
        end
    end)

    task.wait(1.5)

    disableGodGraphics()
    KamuiRing.Visible = false
    if spinGuiConn then spinGuiConn:Disconnect() end

    -- 2. Teletransporte al gran santuario
    local targetPos = not insideRealm and (basePos + Vector3.new(0, 150, 0)) or (originalCFrame and originalCFrame.Position or (basePos + Vector3.new(0, 60, 0)))

    pcall(function()
        hum.PlatformStand = true
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end)

    root.CFrame = CFrame.new(targetPos)
    task.wait(0.05)

    insideRealm = not insideRealm

    -- 3. ESFERA NEGRA MEJORADA CON PARTÍCULAS DE PODER Y GIRO FFLING SALVAJE
    local vortex = Instance.new("Part")
    vortex.Size = Vector3.new(2, 2, 2)
    vortex.Transparency = 1
    vortex.Anchored = true
    vortex.CanCollide = false
    vortex.CFrame = root.CFrame
    vortex.Parent = Workspace
    activeVortex = vortex

    local neonSphere = Instance.new("Part")
    neonSphere.Shape = Enum.PartType.Ball
    neonSphere.Size = Vector3.new(1, 1, 1)
    neonSphere.Color = Color3.fromRGB(0, 0, 0)
    neonSphere.Material = Enum.Material.Neon
    neonSphere.Anchored = true
    neonSphere.CanCollide = false
    neonSphere.CFrame = vortex.CFrame
    neonSphere.Parent = vortex

    -- Partículas explosivas alrededor de la bola
    local p1 = Instance.new("ParticleEmitter")
    p1.Color = ColorSequence.new(Color3.fromRGB(150, 0, 255), Color3.fromRGB(0, 0, 0))
    p1.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 4)})
    p1.Texture = "rbxassetid://258124463"
    p1.Rate = 1000
    p1.Speed = NumberRange.new(15, 30)
    p1.Lifetime = NumberRange.new(0.2, 0.4)
    p1.SpreadAngle = Vector2.new(360, 360)
    p1.Parent = vortex

    local p2 = Instance.new("ParticleEmitter")
    p2.Color = ColorSequence.new(Color3.fromRGB(255, 20, 80), Color3.fromRGB(10, 10, 10))
    p2.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 0.1)})
    p2.Texture = "rbxassetid://1084991215"
    p2.Rate = 800
    p2.Speed = NumberRange.new(20, 35)
    p2.Lifetime = NumberRange.new(0.2, 0.4)
    p2.SpreadAngle = Vector2.new(180, 180)
    p2.Parent = vortex

    TweenService:Create(neonSphere, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = Vector3.new(8, 8, 8)
    }):Play()

    root.Anchored = true

    -- Giro salvaje tipo Fling mejorado e intenso
    local ax, ay, az = 0, 0, 0
    if vortexFlingConn then vortexFlingConn:Disconnect() end
    vortexFlingConn = RunService.RenderStepped:Connect(function()
        if vortex and vortex.Parent and root and root.Parent then
            ax = ax + 50
            ay = ay + 85
            az = az + 60
            local wildCF = vortex.CFrame * CFrame.Angles(math.rad(ax), math.rad(ay), math.rad(az))
            vortex.CFrame = wildCF
            root.CFrame = wildCF
        end
    end)

    local jumpConn
    jumpConn = hum.Jumping:Connect(function()
        if jumpConn then jumpConn:Disconnect() end
        pcall(function()
            if vortexFlingConn then vortexFlingConn:Disconnect() end
            root.Anchored = false
            hum.PlatformStand = false
            if activeVortex then activeVortex:Destroy() end
            disableGodGraphics()
        end)
        activeState = false
    end)

    task.delay(20, function()
        if activeState then
            if jumpConn then jumpConn:Disconnect() end
            pcall(function()
                if vortexFlingConn then vortexFlingConn:Disconnect() end
                root.Anchored = false
                hum.PlatformStand = false
                if activeVortex then activeVortex:Destroy() end
                disableGodGraphics()
            end)
            activeState = false
        end
    end)
end

-- 5. Conexiones táctiles directas para Tablet
KamuiButton.MouseButton1Click:Connect(executeKamui)
KamuiButton.TouchTap:Connect(executeKamui)

print("¡Dimensión God Mode y Esfera Épica Cargadas con Éxito!")
