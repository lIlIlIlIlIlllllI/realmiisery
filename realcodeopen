-- Funciones para manejar la atmósfera carmesí exactamente durante el Mangekyo
local activeAtmosphere, activeCorrection = nil, nil

local function enableCrimsonAtmosphere()
    pcall(function()
        if activeAtmosphere then activeAtmosphere:Destroy() end
        if activeCorrection then activeCorrection:Destroy() end

        activeAtmosphere = Instance.new("Atmosphere")
        activeAtmosphere.Name = "KamuiAtmos"
        activeAtmosphere.Density = 0.55
        activeAtmosphere.Color = Color3.fromRGB(220, 10, 10)
        activeAtmosphere.Decay = Color3.fromRGB(40, 0, 0)
        activeAtmosphere.Parent = Lighting

        activeCorrection = Instance.new("ColorCorrectionEffect")
        activeCorrection.Name = "KamuiCorr"
        activeCorrection.TintColor = Color3.fromRGB(255, 40, 40)
        activeCorrection.Brightness = -0.05
        activeCorrection.Contrast = 0.5
        activeCorrection.Parent = Lighting
    end)
end

local function disableCrimsonAtmosphere()
    pcall(function()
        if activeAtmosphere then activeAtmosphere:Destroy() end
        if activeCorrection then activeCorrection:Destroy() end
        activeAtmosphere = nil
        activeCorrection = nil
    end)
end

local insideRealm = false
local originalCFrame = nil
local activeState = false
local activeVortex = nil
local spinGuiConn = nil
local vortexFlingConn = nil

local function executeKamui()
    if activeState then return end
    activeState = true

    local char = lp.Character
    if not char then activeState = false return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then activeState = false return end

    if not insideRealm then
        originalCFrame = root.CFrame
    end

    -- 1. Activar sonido, efecto carmesí y mostrar Mangekyo girando
    pcall(function()
        KamuiSound.TimePosition = 0
        KamuiSound:Play()
    end)
    enableCrimsonAtmosphere()

    KamuiRing.Visible = true
    KamuiRing.Size = UDim2.new(0, 0, 0, 0)
    KamuiRing.Rotation = 0

    TweenService:Create(KamuiRing, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 600, 0, 600)
    }):Play()

    if spinGuiConn then spinGuiConn:Disconnect() end
    spinGuiConn = RunService.RenderStepped:Connect(function()
        if KamuiRing.Visible then
            KamuiRing.Rotation = KamuiRing.Rotation + 35
        end
    end)

    -- Mantener el logo y el efecto carmesí en pantalla durante la secuencia
    task.wait(1.5)

    -- 2. Desactivar el efecto carmesí y ocultar el Mangekyo justo al desaparecer el logo
    disableCrimsonAtmosphere()
    KamuiRing.Visible = false
    if spinGuiConn then spinGuiConn:Disconnect() end

    -- 3. Teletransporte a la dimensión
    local targetPos = not insideRealm and (basePos + Vector3.new(0, 100, 0)) or (originalCFrame and originalCFrame.Position or (basePos + Vector3.new(0, 40, 0)))

    pcall(function()
        hum.PlatformStand = true
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end)

    root.CFrame = CFrame.new(targetPos)
    task.wait(0.05)

    insideRealm = not insideRealm

    -- 4. Esfera negra neón y giro salvaje tipo Fling
    local vortex = Instance.new("Part")
    vortex.Size = Vector3.new(2, 2, 2)
    vortex.Transparency = 1
    vortex.Anchored = true
    vortex.CanCollide = false
    vortex.CFrame = root.CFrame
    vortex.Parent = Workspace
    activeVortex = vortex

    local neonSphere = Instance.new("Part")
    neonSphere.Shape = Enum.PartType.Ball
    neonSphere.Size = Vector3.new(1, 1, 1)
    neonSphere.Color = Color3.fromRGB(0, 0, 0)
    neonSphere.Material = Enum.Material.Neon
    neonSphere.Anchored = true
    neonSphere.CanCollide = false
    neonSphere.CFrame = vortex.CFrame
    neonSphere.Parent = vortex

    TweenService:Create(neonSphere, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = Vector3.new(6, 6, 6)
    }):Play()

    root.Anchored = true

    local ax, ay, az = 0, 0, 0
    if vortexFlingConn then vortexFlingConn:Disconnect() end
    vortexFlingConn = RunService.RenderStepped:Connect(function()
        if vortex and vortex.Parent and root and root.Parent then
            ax = ax + 40
            ay = ay + 70
            az = az + 45
            local wildCF = vortex.CFrame * CFrame.Angles(math.rad(ax), math.rad(ay), math.rad(az))
            vortex.CFrame = wildCF
            root.CFrame = wildCF
        end
    end)

    local jumpConn
    jumpConn = hum.Jumping:Connect(function()
        if jumpConn then jumpConn:Disconnect() end
        pcall(function()
            if vortexFlingConn then vortexFlingConn:Disconnect() end
            root.Anchored = false
            hum.PlatformStand = false
            if activeVortex then activeVortex:Destroy() end
            disableCrimsonAtmosphere()
        end)
        activeState = false
    end)

    task.delay(20, function()
        if activeState then
            if jumpConn then jumpConn:Disconnect() end
            pcall(function()
                if vortexFlingConn then vortexFlingConn:Disconnect() end
                root.Anchored = false
                hum.PlatformStand = false
                if activeVortex then activeVortex:Destroy() end
                disableCrimsonAtmosphere()
            end)
            activeState = false
        end
    end)
end

-- 5. Conexión de eventos táctiles garantizados
KamuiButton.MouseButton1Click:Connect(executeKamui)
KamuiButton.TouchTap:Connect(executeKamui)
