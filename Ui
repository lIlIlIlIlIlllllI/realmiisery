-- Framework UI de Miisery Hub (12 Partes Perfectas - Sin separaciones ni fallos)
local MiiseryUI = {}
MiiseryUI.__index = MiiseryUI

function MiiseryUI.new(customProperties)
    customProperties = customProperties or {}
    
    local self = setmetatable({}, MiiseryUI)
    
    self.Configuration = {
        WindowTitle = customProperties.Title or "Miisery Hub",
        WindowSubtitle = customProperties.Subtitle or "Advanced Script Engine",
        -- Las 12 partes ordenadas estrictamente del 1 (arriba) al 12 (abajo)
        BackgroundParts = customProperties.BackgroundParts or {
            "114190662442676", -- Parte 1 (Superior)
            "120046269451482", -- Parte 2
            "140082597612823", -- Parte 3
            "129273225975036", -- Parte 4
            "80024750464714",  -- Parte 5
            "88842229046939",  -- Parte 6
            "79539639499471",  -- Parte 7
            "91763108447180",  -- Parte 8
            "99723228983167",  -- Parte 9
            "128087290942098", -- Parte 10
            "80565014387441",  -- Parte 11
            "109823947239244"  -- Parte 12 (Inferior)
        },
        ThemeAccentColor = customProperties.AccentColor or Color3.fromRGB(160, 70, 255),
        DefaultSize = customProperties.Size or UDim2.new(0, 560, 0, 340),
        ExpandedSize = customProperties.ExpandedSize or UDim2.new(0, 700, 0, 420),
        DefaultPosition = customProperties.Position or UDim2.new(0.5, -280, 0.5, -170),
    }
    
    self.ActiveStrokesRegistry = {}
    self.RegisteredTabsList = {}
    self.IsInterfaceVisible = false
    self.IsInterfaceMinimized = false
    self.IsInterfaceExpanded = false
    
    local CoreGui = game:GetService("CoreGui")
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    
    local localPlayer = Players.LocalPlayer
    local playerGui = localPlayer:WaitForChild("PlayerGui")
    
    self.RootScreenGui = Instance.new("ScreenGui")
    self.RootScreenGui.Name = "MiiseryEngine_Container"
    self.RootScreenGui.ResetOnSpawn = false
    self.RootScreenGui.Enabled = false
    self.RootScreenGui.Parent = (gethui and gethui()) or CoreGui or playerGui
    
    self.MainContainer = Instance.new("Frame", self.RootScreenGui)
    self.MainContainer.Name = "MainContainer"
    self.MainContainer.Size = self.Configuration.DefaultSize
    self.MainContainer.Position = self.Configuration.DefaultPosition
    self.MainContainer.BackgroundColor3 = Color3.fromRGB(9, 9, 12)
    self.MainContainer.ClipsDescendants = true
    self.MainContainer.Active = true
    self.MainContainer.Draggable = true
    
    local mainCorner = Instance.new("UICorner", self.MainContainer)
    mainCorner.CornerRadius = UDim.new(0, 10)
    
    self.MainContainerStroke = Instance.new("UIStroke", self.MainContainer)
    self.MainContainerStroke.Color = self.Configuration.ThemeAccentColor
    self.MainContainerStroke.Thickness = 1.5
    self.MainContainerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    table.insert(self.ActiveStrokesRegistry, self.MainContainerStroke)
    
    -- CONTENEDOR DE LAS 12 PARTES DEL BACKGROUND (Posicionamiento matemático exacto sin huecos)
    self.BackgroundHolder = Instance.new("Frame", self.MainContainer)
    self.BackgroundHolder.Name = "BackgroundHolder"
    self.BackgroundHolder.Size = UDim2.new(1, 0, 1, 0)
    self.BackgroundHolder.BackgroundTransparency = 1
    self.BackgroundHolder.ClipsDescendants = true
    self.BackgroundHolder.ZIndex = 1
    
    local bgHolderCorner = Instance.new("UICorner", self.BackgroundHolder)
    bgHolderCorner.CornerRadius = UDim.new(0, 10)
    
    self.BackgroundPartImages = {}
    local totalParts = 12
    
    for i = 1, totalParts do
        local partImage = Instance.new("ImageLabel", self.BackgroundHolder)
        partImage.Name = "BackgroundPart_" .. tostring(i)
        
        -- Cálculo matemático directo de la posición Y para evitar separaciones por layouts
        local heightScale = 1 / totalParts
        local posYScale = (i - 1) * heightScale
        
        -- Usamos un milímetro extra de solapamiento (1.02 de altura) para garantizar cero líneas divisorias
        partImage.Size = UDim2.new(1, 0, heightScale + 0.002, 0)
        partImage.Position = UDim2.new(0, 0, posYScale, 0)
        
        partImage.BackgroundTransparency = 1
        partImage.BorderSizePixel = 0
        partImage.Image = "rbxassetid://" .. tostring(self.Configuration.BackgroundParts[i])
        partImage.ScaleType = Enum.ScaleType.Stretch
        partImage.ZIndex = 1
        
        table.insert(self.BackgroundPartImages, partImage)
    end

    -- Sidebar y Controles Principales
    self.SidebarPanel = Instance.new("Frame", self.MainContainer)
    self.SidebarPanel.Name = "SidebarPanel"
    self.SidebarPanel.Size = UDim2.new(0, 135, 1, -12)
    self.SidebarPanel.Position = UDim2.new(0, 6, 0, 6)
    self.SidebarPanel.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
    self.SidebarPanel.BackgroundTransparency = 0.25
    self.SidebarPanel.ZIndex = 2
    
    local sidebarCorner = Instance.new("UICorner", self.SidebarPanel)
    sidebarCorner.CornerRadius = UDim.new(0, 8)
    
    self.SidebarPanelStroke = Instance.new("UIStroke", self.SidebarPanel)
    self.SidebarPanelStroke.Color = self.Configuration.ThemeAccentColor
    self.SidebarPanelStroke.Thickness = 0.8
    table.insert(self.ActiveStrokesRegistry, self.SidebarPanelStroke)
    
    self.HeaderTitleInstance = Instance.new("TextLabel", self.SidebarPanel)
    self.HeaderTitleInstance.Size = UDim2.new(1, -10, 0, 16)
    self.HeaderTitleInstance.Position = UDim2.new(0, 8, 0, 8)
    self.HeaderTitleInstance.BackgroundTransparency = 1
    self.HeaderTitleInstance.Text = self.Configuration.WindowTitle
    self.HeaderTitleInstance.TextColor3 = Color3.fromRGB(255, 255, 255)
    self.HeaderTitleInstance.Font = Enum.Font.GothamBold
    self.HeaderTitleInstance.TextSize = 11
    self.HeaderTitleInstance.TextXAlignment = Enum.TextXAlignment.Left
    self.HeaderTitleInstance.ZIndex = 3

    local windowHeaderControls = Instance.new("Frame", self.MainContainer)
    windowHeaderControls.Size = UDim2.new(0, 30, 0, 24)
    windowHeaderControls.Position = UDim2.new(1, -36, 0, 6)
    windowHeaderControls.BackgroundTransparency = 1
    windowHeaderControls.ZIndex = 10
    
    local closeButton = Instance.new("TextButton", windowHeaderControls)
    closeButton.Size = UDim2.new(0, 22, 0, 22)
    closeButton.BackgroundTransparency = 1
    closeButton.Text = "×"
    closeButton.TextColor3 = Color3.fromRGB(255, 140, 0)
    closeButton.Font = Enum.Font.GothamBold
    closeButton.TextSize = 18
    closeButton.ZIndex = 11
    
    closeButton.MouseButton1Click:Connect(function()
        pcall(function() self.RootScreenGui:Destroy() end)
    end)
    
    return self
end

function MiiseryUI:SetVisibility(visibleState)
    self.RootScreenGui.Enabled = visibleState
    self.MainContainer.Visible = visibleState
end

