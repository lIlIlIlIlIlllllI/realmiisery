local normalSize = UDim2.new(0, 520, 0, 310)
local closedSize = UDim2.new(0, 0, 0, 0)

local function AnimateUI(open)
    if animating then return end
    animating = true

    if open then
        MainContainer.Visible = true
        MainContainer.Position = initialExecutionPos
        local tween = TweenService:Create(MainContainer, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = normalSize})
        tween:Play()
        tween.Completed:Wait()
        isOpen = true
    else
        local tween = TweenService:Create(MainContainer, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = closedSize})
        tween:Play()
        tween.Completed:Wait()
        MainContainer.Visible = false
        isOpen = false
    end
    animating = false
end

