local function setupBackground(presetName)
    for i = 1, #BackgroundPartImages do
        if BackgroundPartImages[i] then BackgroundPartImages[i]:Destroy() end
    end
    BackgroundPartImages = {}
    BackgroundImage = nil

    local preset = BackgroundPresets[presetName]
    if preset and #preset == 12 then
        local totalParts = 12
        for i = 1, totalParts do
            local partImage = Instance.new("ImageLabel", BackgroundHolder)
            partImage.Name = "BackgroundPart_" .. tostring(i)
            local heightScale = 1 / totalParts
            local posYScale = (i - 1) * heightScale
            partImage.Size = UDim2.new(1, 0, heightScale + 0.002, 0)
            partImage.Position = UDim2.new(0, 0, posYScale, 0)
            partImage.BackgroundTransparency = 1
            partImage.BorderSizePixel = 0
            partImage.Image = "rbxassetid://" .. tostring(preset[i])
            partImage.ScaleType = Enum.ScaleType.Stretch
            partImage.ZIndex = 1
            table.insert(BackgroundPartImages, partImage)
        end
    else
        BackgroundImage = Instance.new("ImageLabel", BackgroundHolder)
        BackgroundImage.Name = "BackgroundImage"
        BackgroundImage.Size = UDim2.new(1, 0, 1, 0)
        BackgroundImage.BackgroundTransparency = 0.15
        BackgroundImage.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
        BackgroundImage.Image = "rbxassetid://" .. tostring(presetName)
        BackgroundImage.ScaleType = Enum.ScaleType.Crop
        BackgroundImage.ZIndex = 1
        Instance.new("UICorner", BackgroundImage).CornerRadius = UDim.new(0, 10)
        table.insert(BackgroundPartImages, BackgroundImage)
    end
end

