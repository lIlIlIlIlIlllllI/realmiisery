-- Plataformas interactivas y objetos de poder dentro de la dimensión
local function createPocketArtifact(offset, color)
    local pedestal = Instance.new("Part")
    pedestal.Shape = Enum.PartType.Cylinder
    pedestal.Size = Vector3.new(12, 50, 12)
    pedestal.Position = basePos + offset + Vector3.new(0, 230, 0)
    pedestal.Anchored = true
    pedestal.Color = Color3.fromRGB(40, 40, 45)
    pedestal.Material = Enum.Material.Metal
    pedestal.Parent = pocketDimensionFolder

    local artifact = Instance.new("Part")
    artifact.Shape = Enum.PartType.Ball
    artifact.Size = Vector3.new(40, 40, 40)
    artifact.Position = basePos + offset + Vector3.new(0, 275, 0)
    artifact.Anchored = true
    artifact.CanCollide = false
    artifact.Color = color
    artifact.Material = Enum.Material.Neon
    artifact.Parent = pocketDimensionFolder

    task.spawn(function()
        local t = math.random(1, 100)
        while artifact and artifact.Parent do
            t = t + 0.05
            artifact.Position = (basePos + offset + Vector3.new(0, 275, 0)) + Vector3.new(0, math.sin(t) * 12, 0)
            task.wait(0.03)
        end
    end)
end

