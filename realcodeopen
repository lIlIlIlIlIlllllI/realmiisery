local function ApplyTheme(isDarkWhite, customColor)
    if isDarkWhite then
        strokeColor = Color3.fromRGB(255, 255, 255)
        darkBgColor = Color3.fromRGB(10, 10, 10)
        cardBgColor = Color3.fromRGB(16, 16, 16)
    else
        strokeColor = customColor
        darkBgColor = customColor:Lerp(Color3.fromRGB(0, 0, 0), 0.88)
        cardBgColor = customColor:Lerp(Color3.fromRGB(0, 0, 0), 0.80)
    end

    for _, str in ipairs(allStrokes) do
        if str and str.Parent then str.Color = strokeColor end
    end
    for _, card in ipairs(allCards) do
        if card and card.Parent then
            if card == MainContainer or card == ConfirmBox or card == ConfigBox then
                card.BackgroundColor3 = darkBgColor
            else
                card.BackgroundColor3 = cardBgColor
            end
        end
    end
end

