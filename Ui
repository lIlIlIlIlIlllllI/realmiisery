function MiiseryUI:SetVisibility(visibleState)
    self.IsInterfaceVisible = visibleState ~= nil and visibleState or not self.IsInterfaceVisible
    if self.IsInterfaceMinimized then
        self.RootScreenGui.Enabled = true
        self.MinimizedPill.Visible = self.IsInterfaceVisible
        self.MainContainer.Visible = false
    else
        self.RootScreenGui.Enabled = self.IsInterfaceVisible
        self.MainContainer.Visible = self.IsInterfaceVisible
        self.MinimizedPill.Visible = false
    end
end

function MiiseryUI:MinimizeInterface()
    if self.IsInterfaceMinimized then return end
    self.IsInterfaceMinimized = true
    TweenService:Create(self.MainContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = self.MainContainer.Position + UDim2.new(0, 280, 0, 170)
    }):Play()
    task.wait(0.2)
    self.MainContainer.Visible = false
    self.MinimizedPill.Size = UDim2.new(0, 0, 0, 36)
    self.MinimizedPill.Visible = true
    TweenService:Create(self.MinimizedPill, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 175, 0, 36)
    }):Play()
end

function MiiseryUI:RestoreInterface()
    if not self.IsInterfaceMinimized then return end
    TweenService:Create(self.MinimizedPill, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 36)
    }):Play()
    task.wait(0.15)
    self.MinimizedPill.Visible = false
    self.MainContainer.Size = UDim2.new(0, 0, 0, 0)
    self.MainContainer.Visible = true
    TweenService:Create(self.MainContainer, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = self.Configuration.DefaultSize,
        Position = self.Configuration.DefaultPosition
    }):Play()
    task.wait(0.3)
    self.IsInterfaceMinimized = false
end

function MiiseryUI:ToggleExpandInterface()
    self.IsInterfaceExpanded = not self.IsInterfaceExpanded
    local targetSize = self.IsInterfaceExpanded and self.Configuration.ExpandedSize or self.Configuration.DefaultSize
    local targetPos = self.IsInterfaceExpanded and UDim2.new(0.5, -350, 0.5, -210) or self.Configuration.DefaultPosition
    TweenService:Create(self.MainContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = targetSize,
        Position = targetPos
    }):Play()
end

function MiiseryUI:UpdateAccentColor(newColor)
    self.Configuration.ThemeAccentColor = newColor
    for _, strokeObject in ipairs(self.ActiveStrokesRegistry) do
        if strokeObject and strokeObject.Parent then
            strokeObject.Color = newColor
        end
    end
end

function MiiseryUI:UpdateBackgroundAsset(newAssetId)
    self.Configuration.AssetIdentifier = tostring(newAssetId)
    local formattedUri = "rbxassetid://" .. self.Configuration.AssetIdentifier
    pcall(function()
        self.BackgroundArtwork.Image = ""
        task.wait(0.02)
        self.BackgroundArtwork.Image = formattedUri
        self.SidebarLogoIcon.Image = formattedUri
        self.PillLogoIcon.Image = formattedUri
    end)
end

function MiiseryUI:UpdateMetadata(newTitle, newSubtitle)
    if newTitle then
        self.Configuration.WindowTitle = newTitle
        self.HeaderTitleInstance.Text = newTitle
    end
    if newSubtitle then
        self.Configuration.WindowSubtitle = newSubtitle
        self.HeaderSubtitleInstance.Text = newSubtitle
    end
end

function MiiseryUI:CreateTab(tabTitleName)
    local tabConstruct = {}
    local isInitialTab = (#self.RegisteredTabsList == 0)
    table.insert(self.RegisteredTabsList, tabTitleName)
    
    local tabNavigationButton = Instance.new("TextButton", self.NavigationScrollingFrame)
    tabNavigationButton.Name = tabTitleName .. "TabButton"
    tabNavigationButton.LayoutOrder = #self.RegisteredTabsList
    tabNavigationButton.Size = UDim2.new(1, 0, 0, 26)
    tabNavigationButton.BackgroundColor3 = isInitialTab and Color3.fromRGB(25, 25, 30) or Color3.fromRGB(12, 12, 15)
    tabNavigationButton.BackgroundTransparency = 0.2
    tabNavigationButton.Text = "  " .. tabTitleName
    tabNavigationButton.TextColor3 = isInitialTab and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(170, 170, 170)
    tabNavigationButton.Font = Enum.Font.GothamMedium
    tabNavigationButton.TextSize = 10
    tabNavigationButton.TextXAlignment = Enum.TextXAlignment.Left
    tabNavigationButton.ZIndex = 3
    
    local buttonCorner = Instance.new("UICorner", tabNavigationButton)
    buttonCorner.CornerRadius = UDim.new(0, 6)
    
    local buttonStroke = Instance.new("UIStroke", tabNavigationButton)
    buttonStroke.Color = isInitialTab and self.Configuration.ThemeAccentColor or Color3.fromRGB(60, 60, 60)
    buttonStroke.Thickness = 0.8
    table.insert(self.ActiveStrokesRegistry, buttonStroke)
    
    local tabPageContainer = Instance.new("ScrollingFrame", self.PagesContainerFolder)
    tabPageContainer.Name = tabTitleName .. "Page"
    tabPageContainer.Size = UDim2.new(1, -155, 1, -42)
    tabPageContainer.Position = UDim2.new(0, 145, 0, 36)
    tabPageContainer.BackgroundTransparency = 1
    tabPageContainer.ScrollBarThickness = 2
    tabPageContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabPageContainer.Visible = isInitialTab
    tabPageContainer.ZIndex = 2
    tabPageContainer.ClipsDescendants = true
    
    local pageLayout = Instance.new("UIListLayout", tabPageContainer)
    pageLayout.Padding = UDim.new(0, 6)
    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabPageContainer.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 15)
    end)
    
    tabNavigationButton.MouseButton1Click:Connect(function()
        for _, pageNode in ipairs(self.PagesContainerFolder:GetChildren()) do
            pageNode.Visible = false
        end
        for _, btnNode in ipairs(self.NavigationScrollingFrame:GetChildren()) do
            if btnNode:IsA("TextButton") then
                btnNode.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
                btnNode.TextColor3 = Color3.fromRGB(170, 170, 170)
                local strNode = btnNode:FindFirstChildOfClass("UIStroke")
                if strNode then
                    strNode.Color = Color3.fromRGB(60, 60, 60)
                end
            end
        end
        tabPageContainer.Visible = true
        tabNavigationButton.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        tabNavigationButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        buttonStroke.Color = self.Configuration.ThemeAccentColor
    end)
    
    function tabConstruct:AddToggle(settingsData)
        local labelText = settingsData.Title or "Toggle"
        local initialState = settingsData.Value or false
        local callbackFn = settingsData.Callback or function() end
        local currentState = initialState
        
        local elementFrame = Instance.new("Frame", tabPageContainer)
        elementFrame.Size = UDim2.new(1, -6, 0, 30)
        elementFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
        elementFrame.BackgroundTransparency = 0.25
        elementFrame.ZIndex = 3
        
        local frameCorner = Instance.new("UICorner", elementFrame)
        frameCorner.CornerRadius = UDim.new(0, 6)
        
        local frameStroke = Instance.new("UIStroke", elementFrame)
        frameStroke.Color = Color3.fromRGB(80, 80, 80)
        frameStroke.Thickness = 0.8
        
        local textLabel = Instance.new("TextLabel", elementFrame)
        textLabel.Size = UDim2.new(1, -45, 1, 0)
        textLabel.Position = UDim2.new(0, 10, 0, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = labelText
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLabel.Font = Enum.Font.GothamMedium
        textLabel.TextSize = 10
        textLabel.TextXAlignment = Enum.TextXAlignment.Left
        textLabel.ZIndex = 4
        
        local toggleSwitch = Instance.new("TextButton", elementFrame)
        toggleSwitch.Size = UDim2.new(0, 26, 0, 14)
        toggleSwitch.Position = UDim2.new(1, -34, 0.5, -7)
        toggleSwitch.BackgroundColor3 = currentState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 40)
        toggleSwitch.Text = ""
        toggleSwitch.ZIndex = 4
        
        local switchCorner = Instance.new("UICorner", toggleSwitch)
        switchCorner.CornerRadius = UDim.new(1, 0)
        
        toggleSwitch.MouseButton1Click:Connect(function()
            currentState = not currentState
            toggleSwitch.BackgroundColor3 = currentState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 40)
            pcall(callbackFn, currentState)
        end)
    end
    
    function tabConstruct:AddButton(settingsData)
        local labelText = settingsData.Title or "Button"
        local callbackFn = settingsData.Callback or function() end
        
        local buttonElement = Instance.new("TextButton", tabPageContainer)
        buttonElement.Size = UDim2.new(1, -6, 0, 30)
        buttonElement.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
        buttonElement.BackgroundTransparency = 0.25
        buttonElement.Text = "  " .. labelText
        buttonElement.TextColor3 = Color3.fromRGB(255, 255, 255)
        buttonElement.Font = Enum.Font.GothamMedium
        buttonElement.TextSize = 10
        buttonElement.TextXAlignment = Enum.TextXAlignment.Left
        buttonElement.ZIndex = 3
        
        local btnCorner = Instance.new("UICorner", buttonElement)
        btnCorner.CornerRadius = UDim.new(0, 6)
        
        local btnStroke = Instance.new("UIStroke", buttonElement)
        btnStroke.Color = Color3.fromRGB(80, 80, 80)
        btnStroke.Thickness = 0.8
        
        buttonElement.MouseButton1Click:Connect(function()
            pcall(callbackFn)
        end)
    end
    
    return tabConstruct
end

function MiiseryUI:DestroyInterface()
    pcall(function()
        self.RootScreenGui:Destroy()
    end)
end

return MiiseryUI
