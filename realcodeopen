-- Función para activar el Skybox público ID 136055162054954 y la atmósfera roja
local function setAudioSkybox(state)
    pcall(function()
        if state then
            if not Lighting:FindFirstChild("DynamicKamuiSky") then
                local sky = Instance.new("Sky")
                sky.Name = "DynamicKamuiSky"
                sky.SkyboxBk = "rbxassetid://136055162054954"
                sky.SkyboxDn = "rbxassetid://136055162054954"
                sky.SkyboxFt = "rbxassetid://136055162054954"
                sky.SkyboxLf = "rbxassetid://136055162054954"
                sky.SkyboxRt = "rbxassetid://136055162054954"
                sky.SkyboxUp = "rbxassetid://136055162054954"
                sky.Parent = Lighting
            end

            if not Lighting:FindFirstChild("NaturalRedAtmosphere") then
                local atmos = Instance.new("Atmosphere")
                atmos.Name = "NaturalRedAtmosphere"
                atmos.Density = 0.35
                atmos.Offset = 0
                atmos.Color = Color3.fromRGB(240, 30, 30)
                atmos.Decay = Color3.fromRGB(100, 10, 10)
                atmos.Glare = 0.6
                atmos.Haze = 1.2
                atmos.Parent = Lighting
            end

            if not Lighting:FindFirstChild("NaturalRedCorrection") then
                local corr = Instance.new("ColorCorrectionEffect")
                corr.Name = "NaturalRedCorrection"
                corr.TintColor = Color3.fromRGB(255, 120, 120)
                corr.Contrast = 0.25
                corr.Brightness = 0.02
                corr.Parent = Lighting
            end
        else
            if Lighting:FindFirstChild("DynamicKamuiSky") then Lighting.DynamicKamuiSky:Destroy() end
            if Lighting:FindFirstChild("NaturalRedAtmosphere") then Lighting.NaturalRedAtmosphere:Destroy() end
            if Lighting:FindFirstChild("NaturalRedCorrection") then Lighting.NaturalRedCorrection:Destroy() end
        end
    end)
end

-- Pintar todos los bloques de la dimensión en rojo brillante
local function paintDimensionBlocks(isRed)
    pcall(function()
        local folder = Workspace:FindFirstChild("_DirectKamuiDimension")
        if folder then
            for _, obj in ipairs(folder:GetChildren()) do
                if obj:IsA("Part") and obj.Name == "DimensionBlock" then
                    if isRed then
                        obj.Color = Color3.fromRGB(255, 20, 20) -- Rojo brillante
                    else
                        obj.Color = Color3.fromRGB(150, 220, 245) -- Celeste pastel normal
                    end
                end
            end
        end
    end)
end

-- Construcción de la dimensión masiva
local dimCenter = Vector3.new(0, 1500, 0)

local function buildDimension()
    if Workspace:FindFirstChild("_DirectKamuiDimension") then return end

    local folder = Instance.new("Folder")
    folder.Name = "_DirectKamuiDimension"
    folder.Parent = Workspace

    local mapSize = 600
    local wallHeight = 350
    local half = mapSize / 2

    local baseFloor = Instance.new("Part")
    baseFloor.Name = "DimensionBlock"
    baseFloor.Size = Vector3.new(mapSize, 4, mapSize)
    baseFloor.Position = dimCenter - Vector3.new(0, 3, 0)
    baseFloor.Anchored = true
    baseFloor.CastShadow = false
    baseFloor.Color = Color3.fromRGB(150, 220, 245)
    baseFloor.Material = Enum.Material.SmoothPlastic
    baseFloor.Parent = folder

    local roof = Instance.new("Part")
    roof.Size = Vector3.new(mapSize, 6, mapSize)
    roof.Position = dimCenter + Vector3.new(0, wallHeight + 3, 0)
    roof.Anchored = true
    roof.CastShadow = false
    roof.Color = Color3.fromRGB(15, 15, 20)
    roof.Material = Enum.Material.SmoothPlastic
    roof.Parent = folder

    local function createWall(size, cf)
        local w = Instance.new("Part")
        w.Size = size
        w.CFrame = cf
        w.Anchored = true
        w.CastShadow = false
        w.Color = Color3.fromRGB(15, 15, 20)
        w.Material = Enum.Material.SmoothPlastic
        w.Parent = folder
    end

    createWall(Vector3.new(mapSize, wallHeight, 12), CFrame.new(dimCenter + Vector3.new(0, wallHeight/2, -half)))
    createWall(Vector3.new(mapSize, wallHeight, 12), CFrame.new(dimCenter + Vector3.new(0, wallHeight/2, half)))
    createWall(Vector3.new(12, wallHeight, mapSize), CFrame.new(dimCenter + Vector3.new(half, wallHeight/2, 0)))
    createWall(Vector3.new(12, wallHeight, mapSize), CFrame.new(dimCenter + Vector3.new(-half, wallHeight/2, 0)))

    local tileSize = 80
    local startX = -half + (tileSize / 2)
    local startZ = -half + (tileSize / 2)
    local endX = half - (tileSize / 2)
    local endZ = half - (tileSize / 2)

    math.randomseed(9999)

    for x = startX, endX, tileSize do
        for z = startZ, endZ, tileSize do
            local dist = math.sqrt(x*x + z*z)
            local blockHeight = dist < 90 and 40 or math.floor(80 + (math.sin(x * 0.03) * math.cos(z * 0.03) * 40))

            local block = Instance.new("Part")
            block.Name = "DimensionBlock"
            block.Size = Vector3.new(tileSize, blockHeight, tileSize)
            block.Position = dimCenter + Vector3.new(x, blockHeight / 2, z)
            block.Anchored = true
            block.CastShadow = false
            block.Color = Color3.fromRGB(150, 220, 245)
            block.Material = Enum.Material.SmoothPlastic
            block.Parent = folder
        end
    end
end

local insideRealm = false
local originalCFrame = nil
local activeState = false
local spinConn = nil

local function triggerKamui()
    if activeState then return end
    activeState = true

    buildDimension()

    local char = lp.Character
    if not char then activeState = false return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then activeState = false return end

    if not insideRealm then
        originalCFrame = root.CFrame
    end

    -- Activar el cielo rojo, pintar bloques y mostrar el Skybox ID 136055162054954
    setAudioSkybox(true)
    paintDimensionBlocks(true)

    pcall(function()
        KamuiSound.TimePosition = 0 KamuiSound:Play()
        CrowSound.TimePosition = 0 CrowSound:Play()
    end)

    -- Secuencia visual épica de absorción en pantalla
    KamuiRing.Visible = true
    KamuiRing.Size = UDim2.new(0, 0, 0, 0)
    KamuiRing.Rotation = 0

    BlackHoleCover.Visible = true
    BlackHoleCover.Size = UDim2.new(0, 0, 0, 0)

    TweenService:Create(KamuiRing, TweenInfo.new(0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { 
        Size = UDim2.new(0, 1200, 0, 1200) 
    }):Play()

    if spinConn then spinConn:Disconnect() end
    spinConn = RunService.RenderStepped:Connect(function()
        if KamuiRing.Visible then KamuiRing.Rotation = KamuiRing.Rotation - 50 end
    end)

    task.wait(0.4)

    TweenService:Create(BlackHoleCover, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(2.5, 0, 2.5, 0)
    }):Play()

    task.wait(0.4)

    if spinConn then spinConn:Disconnect() end
    KamuiRing.Visible = false

    local targetPos = not insideRealm and (dimCenter + Vector3.new(0, 60, 0)) or (originalCFrame and originalCFrame.Position or (dimCenter + Vector3.new(0, 60, 0)))

    pcall(function() 
        hum.PlatformStand = true 
        root.AssemblyLinearVelocity = Vector3.new(0,0,0) 
    end)

    -- ÚNICO TELETRANSPORTE LIMPIO Y DIRECTO
    root.CFrame = CFrame.new(targetPos)
    insideRealm = not insideRealm

    TweenService:Create(BlackHoleCover, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 0, 0, 0)
    }):Play()

    task.wait(0.4)
    BlackHoleCover.Visible = false

    pcall(function() hum.PlatformStand = false end)
    activeState = false

    -- Monitorear el audio: en cuanto termine, quitar el Skybox rojo y regresar los bloques a celeste normal
    task.spawn(function()
        while KamuiSound.IsPlaying do
            task.wait(0.1)
        end
        setAudioSkybox(false)
        paintDimensionBlocks(false)
    end)
end

