local allCards = {MainContainer, ToggleButton, GearButton, CloseButton, ConfirmBox, YesButton, NoButton, ConfigBox}

local function ApplyTheme(customColor, isTransparent)
    strokeColor = customColor
    if isTransparent then
        darkBgColor = Color3.new(0, 0, 0)
        cardBgColor = Color3.new(0, 0, 0)
    else
        darkBgColor = customColor:Lerp(Color3.fromRGB(10, 0, 20), 0.85)
        cardBgColor = customColor:Lerp(Color3.fromRGB(20, 5, 35), 0.75)
    end
    for _, str in ipairs(allStrokes) do if str and str.Parent then str.Color = strokeColor end end
    for _, card in ipairs(allCards) do
        if card and card.Parent then
            if isTransparent then
                card.BackgroundTransparency = 1
            else
                card.BackgroundTransparency = 0
                if card == MainContainer or card == ConfirmBox or card == ConfigBox then card.BackgroundColor3 = darkBgColor
                else card.BackgroundColor3 = cardBgColor end
            end
        end
    end
end

