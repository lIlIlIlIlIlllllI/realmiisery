-- 4. Shaders Nocturnos de Halloween y Cinematografía
local activeAtmosphere, activeCorrection, activeBloom = nil, nil, nil

local function enableHalloweenShaders()
    pcall(function()
        if activeAtmosphere then activeAtmosphere:Destroy() end
        if activeCorrection then activeCorrection:Destroy() end
        if activeBloom then activeBloom:Destroy() end

        activeAtmosphere = Instance.new("Atmosphere")
        activeAtmosphere.Name = "HalloweenAtmos"
        activeAtmosphere.Density = 0.55
        activeAtmosphere.Color = Color3.fromRGB(25, 15, 35)
        activeAtmosphere.Decay = Color3.fromRGB(10, 5, 20)
        activeAtmosphere.Parent = Lighting

        activeCorrection = Instance.new("ColorCorrectionEffect")
        activeCorrection.Name = "HalloweenCorr"
        activeCorrection.TintColor = Color3.fromRGB(210, 190, 255)
        activeCorrection.Brightness = -0.08
        activeCorrection.Contrast = 0.45
        activeCorrection.Parent = Lighting

        activeBloom = Instance.new("BloomEffect")
        activeBloom.Name = "HalloweenBloom"
        activeBloom.Intensity = 1.5
        activeBloom.Size = 35
        activeBloom.Threshold = 0.4
        activeBloom.Parent = Lighting
    end)
end

local function disableHalloweenShaders()
    pcall(function()
        if activeAtmosphere then activeAtmosphere:Destroy() end
        if activeCorrection then activeCorrection:Destroy() end
        if activeBloom then activeBloom:Destroy() end
        activeAtmosphere, activeCorrection, activeBloom = nil, nil, nil
    end)
end

local insideRealm = false
local originalCFrame = nil
local activeState = false
local activeVortex = nil
local spinGuiConn = nil
local vortexFlingConn = nil

local function executeKamui()
    if activeState then return end
    activeState = true

    TweenService:Create(KamuiButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 100, 0, 100)
    }):Play()
    task.wait(0.1)
    TweenService:Create(KamuiButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 115, 0, 115)
    }):Play()

    local char = lp.Character
    if not char then activeState = false return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then activeState = false return end

    if not insideRealm then
        originalCFrame = root.CFrame
    end

    -- 1. Sonido y Mangekyo girando perfectamente centrado (INALTERABLE)
    pcall(function()
        KamuiSound.TimePosition = 0
        KamuiSound:Play()
    end)

    KamuiRing.Visible = true
    KamuiRing.Size = UDim2.new(0, 0, 0, 0)
    KamuiRing.Rotation = 0

    TweenService:Create(KamuiRing, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 750, 0, 750)
    }):Play()

    if spinGuiConn then spinGuiConn:Disconnect() end
    spinGuiConn = RunService.RenderStepped:Connect(function()
        if KamuiRing.Visible then
            KamuiRing.Rotation = KamuiRing.Rotation + 40
        end
    end)

    task.wait(1.5)

    KamuiRing.Visible = false
    if spinGuiConn then spinGuiConn:Disconnect() end

    -- 2. Activar shaders y teletransporte a la isla masiva de Halloween
    enableHalloweenShaders()

    local targetPos = not insideRealm and (basePos + Vector3.new(0, 150, 0)) or (originalCFrame and originalCFrame.Position or (basePos + Vector3.new(0, 60, 0)))

    pcall(function()
        hum.PlatformStand = true
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end)

    root.CFrame = CFrame.new(targetPos)
    task.wait(0.05)

    insideRealm = not insideRealm

    -- 3. Núcleo Púrpura de Alta Densidad y Giro Fling Estilo Anime
    local vortex = Instance.new("Part")
    vortex.Size = Vector3.new(2, 2, 2)
    vortex.Transparency = 1
    vortex.Anchored = true
    vortex.CanCollide = false
    vortex.CFrame = root.CFrame
    vortex.Parent = Workspace
    activeVortex = vortex

    local purpleCore = Instance.new("Part")
    purpleCore.Shape = Enum.PartType.Ball
    purpleCore.Size = Vector3.new(1, 1, 1)
    purpleCore.Color = Color3.fromRGB(140, 0, 255)
    purpleCore.Material = Enum.Material.Neon
    purpleCore.Anchored = true
    purpleCore.CanCollide = false
    purpleCore.CFrame = vortex.CFrame
    purpleCore.Parent = vortex

    local appParticle1 = Instance.new("ParticleEmitter")
    appParticle1.Color = ColorSequence.new(Color3.fromRGB(180, 50, 255), Color3.fromRGB(60, 0, 120))
    appParticle1.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 4.5)})
    appParticle1.Texture = "rbxassetid://258124463"
    appParticle1.Rate = 1200
    appParticle1.Speed = NumberRange.new(18, 35)
    appParticle1.Lifetime = NumberRange.new(0.2, 0.4)
    appParticle1.SpreadAngle = Vector2.new(360, 360)
    appParticle1.Parent = vortex

    local appParticle2 = Instance.new("ParticleEmitter")
    appParticle2.Color = ColorSequence.new(Color3.fromRGB(255, 100, 255), Color3.fromRGB(100, 0, 200))
    appParticle2.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.8), NumberSequenceKeypoint.new(1, 0.1)})
    appParticle2.Texture = "rbxassetid://1084991215"
    appParticle2.Rate = 900
    appParticle2.Speed = NumberRange.new(22, 40)
    appParticle2.Lifetime = NumberRange.new(0.2, 0.4)
    appParticle2.SpreadAngle = Vector2.new(180, 180)
    appParticle2.Parent = vortex

    TweenService:Create(purpleCore, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = Vector3.new(9, 9, 9)
    }):Play()

    root.Anchored = true

    local ax, ay, az = 0, 0, 0
    if vortexFlingConn then vortexFlingConn:Disconnect() end
    vortexFlingConn = RunService.RenderStepped:Connect(function()
        if vortex and vortex.Parent and root and root.Parent then
            ax = ax + 50
            ay = ay + 85
            az = az + 60
            local wildCF = vortex.CFrame * CFrame.Angles(math.rad(ax), math.rad(ay), math.rad(az))
            vortex.CFrame = wildCF
            root.CFrame = wildCF
        end
    end)

    local jumpConn
    jumpConn = hum.Jumping:Connect(function()
        if jumpConn then jumpConn:Disconnect() end
        pcall(function()
            if vortexFlingConn then vortexFlingConn:Disconnect() end
            root.Anchored = false
            hum.PlatformStand = false
            if activeVortex then activeVortex:Destroy() end
            disableHalloweenShaders()
        end)
        activeState = false
    end)

    task.delay(20, function()
        if activeState then
            if jumpConn then jumpConn:Disconnect() end
            pcall(function()
                if vortexFlingConn then vortexFlingConn:Disconnect() end
                root.Anchored = false
                hum.PlatformStand = false
                if activeVortex then activeVortex:Destroy() end
                disableHalloweenShaders()
            end)
            activeState = false
        end
    end)
end

