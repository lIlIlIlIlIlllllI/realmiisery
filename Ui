        TabStroke.Color = firstTab and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(60, 60, 60)
        TabStroke.Thickness = 0.8
        table.insert(UIStrokesList, TabStroke)

        local Page = Instance.new("ScrollingFrame", PagesFolder)
        Page.Name = tabName .. "Page"
        Page.Size = UDim2.new(1, -150, 1, -42)
        Page.Position = UDim2.new(0, 142, 0, 36)
        Page.BackgroundTransparency = 1
        Page.ScrollBarThickness = 2
