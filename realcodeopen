-- Silenciador de ruidos del servidor base
local function muteGameSounds(state)
    pcall(function()
        SoundService.AmbientReverb = Enum.ReverbType.NoReverb
        for _, sound in ipairs(Workspace:GetDescendants()) do
            if sound:IsA("Sound") and sound ~= KamuiSound and sound ~= CrowSound then
                sound.Volume = state and 0 or 0.5
            end
        end
    end)
end

