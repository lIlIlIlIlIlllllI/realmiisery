local function getClosestChestInMap()
    local myRoot = humanoidRootPart
    if not myRoot then return nil end
    local bestChest, shortestDist = nil, math.huge
    local function checkContainer(folder)
        if not folder then return end
        local children = folder:GetChildren()
        for i = 1, #children do
            local obj = children[i]
            local name = obj.Name:lower()
            if name:find("chest") then
                local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
                if targetPart and targetPart.Parent then
                    local dist = (targetPart.Position - myRoot.Position).Magnitude
                    if dist < shortestDist then shortestDist = dist bestChest = targetPart end
                end
            end
        end
    end
    checkContainer(Workspace:FindFirstChild("ChestModels"))
    checkContainer(Workspace)
    return bestChest
end

local function getNearestChestInIsland(centerCF, maxDist)
    local myRoot = humanoidRootPart
    if not myRoot then return nil end
    local bestChest, shortestDist = nil, math.huge
    maxDist = maxDist or 3000
    local function checkContainer(folder)
        if not folder then return end
        local children = folder:GetChildren()
        for i = 1, #children do
            local obj = children[i]
            local name = obj.Name:lower()
            if name:find("chest") then
                local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
                if targetPart and targetPart.Parent then
                    local distFromIsland = centerCF and (targetPart.Position - centerCF.Position).Magnitude or 0
                    if not centerCF or distFromIsland <= maxDist then
                        local distFromMe = (targetPart.Position - myRoot.Position).Magnitude
                        if distFromMe < shortestDist then shortestDist = distFromMe bestChest = targetPart end
                    end
                end
            end
        end
    end
    checkContainer(Workspace:FindFirstChild("ChestModels"))
    checkContainer(Workspace)
    return bestChest
end

local function safeTweenTo(targetCFrame, speed)
    local myRoot = humanoidRootPart
    if not myRoot then return end
    local startPos = myRoot.Position
    local endPos = targetCFrame.Position
    local safeY = math.max(startPos.Y, endPos.Y, 95)
    local highPos1 = Vector3.new(startPos.X, safeY + 45, startPos.Z)
    local highPos2 = Vector3.new(endPos.X, safeY + 45, endPos.Z)
    myRoot.CFrame = CFrame.new(highPos1)
    task.wait(0.05)
    local dist = (highPos2 - highPos1).Magnitude
    local timeDuration = math.clamp(dist / speed, 0.6, 20)
    if activeChestTween then activeChestTween:Cancel() end
    activeChestTween = TweenService:Create(myRoot, TweenInfo.new(timeDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = CFrame.new(highPos2) })
    activeChestTween:Play()
    activeChestTween.Completed:Wait()
    local finalDist = (endPos - myRoot.Position).Magnitude
    local finalDuration = math.clamp(finalDist / speed, 0.3, 5)
    if activeChestTween then activeChestTween:Cancel() end
    activeChestTween = TweenService:Create(myRoot, TweenInfo.new(finalDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = targetCFrame })
    activeChestTween:Play()
    activeChestTween.Completed:Wait()
end

