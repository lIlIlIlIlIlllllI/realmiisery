-- Anillos Flotantes Orbitales Alrededor del Jugador (Estilo Sci-Fi / Anime)
local function createOrbitalRing(size, color)
    local ring = Instance.new("Part")
    ring.Shape = Enum.PartType.Cylinder
    ring.Size = size
    ring.Position = basePos + Vector3.new(0, 100, 0)
    ring.Orientation = Vector3.new(90, 0, 0)
    ring.Anchored = true
    ring.CanCollide = false
    ring.Transparency = 0.3
    ring.Color = color
    ring.Material = Enum.Material.Neon
    ring.Parent = dimensionFolder
    return ring
end

