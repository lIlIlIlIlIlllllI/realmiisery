function MiiseryUI:CreateTab(tabName)
    local tabObj = {}
    local isFirst = (#self.Tabs == 0)
    table.insert(self.Tabs, tabName)
    
    local tabBtn = Instance.new("TextButton", self.NavScroll)
    tabBtn.Name = tabName .. "TabButton"
    tabBtn.LayoutOrder = #self.Tabs
    tabBtn.Size = UDim2.new(1, 0, 0, 26)
    tabBtn.BackgroundColor3 = isFirst and Color3.fromRGB(25, 25, 30) or Color3.fromRGB(12, 12, 15)
    tabBtn.BackgroundTransparency = 0.2
    tabBtn.Text = "  " .. tabName
    tabBtn.TextColor3 = isFirst and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(170, 170, 170)
    tabBtn.Font = Enum.Font.GothamMedium
    tabBtn.TextSize = 10
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.ZIndex = 3
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)
    
    local tabStroke = Instance.new("UIStroke", tabBtn)
    tabStroke.Color = isFirst and self.Config.AccentColor or Color3.fromRGB(60, 60, 60)
    tabStroke.Thickness = 0.8
    table.insert(self.UIStrokes, tabStroke)
    
    local page = Instance.new("ScrollingFrame", self.PagesFolder)
    page.Name = tabName .. "Page"
    page.Size = UDim2.new(1, -150, 1, -42)
    page.Position = UDim2.new(0, 142, 0, 36)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 2
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Visible = isFirst
    page.ZIndex = 2
    page.ClipsDescendants = true
    
    local pageLayout = Instance.new("UIListLayout", page)
    pageLayout.Padding = UDim.new(0, 6)
    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 15)
    end)
    
    tabBtn.MouseButton1Click:Connect(function()
        for _, child in ipairs(self.PagesFolder:GetChildren()) do child.Visible = false end
        for _, child in ipairs(self.NavScroll:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
                child.TextColor3 = Color3.fromRGB(170, 170, 170)
                local str = child:FindFirstChildOfClass("UIStroke")
                if str then str.Color = Color3.fromRGB(60, 60, 60) end
            end
        end
        page.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tabStroke.Color = self.Config.AccentColor
    end)
    
    function tabObj:Toggle(data)
        local titleText = data.Title or "Toggle"
        local defaultState = data.Value or false
        local callback = data.Callback or function() end
        local toggled = defaultState
        
        local frame = Instance.new("Frame", page)
        frame.Size = UDim2.new(1, -6, 0, 30)
        frame.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
        frame.BackgroundTransparency = 0.25
        frame.ZIndex = 3
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
        
        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = Color3.fromRGB(80, 80, 80)
        stroke.Thickness = 0.8
        
        local title = Instance.new("TextLabel", frame)
        title.Size = UDim2.new(1, -45, 1, 0)
        title.Position = UDim2.new(0, 10, 0, 0)
        title.BackgroundTransparency = 1
        title.Text = titleText
        title.TextColor3 = Color3.fromRGB(255, 255, 255)
        title.Font = Enum.Font.GothamMedium
        title.TextSize = 10
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.ZIndex = 4
        
        local switch = Instance.new("TextButton", frame)
        switch.Size = UDim2.new(0, 26, 0, 14)
        switch.Position = UDim2.new(1, -34, 0.5, -7)
        switch.BackgroundColor3 = toggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 40)
        switch.Text = ""
        switch.ZIndex = 4
        Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)
        
        switch.MouseButton1Click:Connect(function()
            toggled = not toggled
            switch.BackgroundColor3 = toggled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 40)
            pcall(callback, toggled)
        end)
    end
    
    function tabObj:Button(data)
        local titleText = data.Title or "Button"
        local callback = data.Callback or function() end

        local btn = Instance.new("TextButton", page)
        btn.Size = UDim2.new(1, -6, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
        btn.BackgroundTransparency = 0.25
        btn.Text = "  " .. titleText
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 10
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.ZIndex = 3
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        
        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = Color3.fromRGB(80, 80, 80)
        stroke.Thickness = 0.8

        btn.MouseButton1Click:Connect(function()
            pcall(callback)
        end)
    end

    function tabObj:Slider(data)
        local titleText = data.Title or "Slider"
        local min = data.Value and data.Value.Min or 0
        local max = data.Value and data.Value.Max or 100
        local default = data.Value and data.Value.Default or min
        local callback = data.Callback or function() end

        local frame = Instance.new("Frame", page)
        frame.Size = UDim2.new(1, -6, 0, 40)
        frame.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
        frame.BackgroundTransparency = 0.25
        frame.ZIndex = 3
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local title = Instance.new("TextLabel", frame)
        title.Size = UDim2.new(1, -12, 0, 16)
        title.Position = UDim2.new(0, 10, 0, 4)
        title.BackgroundTransparency = 1
        title.Text = titleText .. ": " .. tostring(default)
        title.TextColor3 = Color3.fromRGB(255, 255, 255)
        title.Font = Enum.Font.GothamMedium
        title.TextSize = 10
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.ZIndex = 4

        local sliderBg = Instance.new("Frame", frame)
        sliderBg.Size = UDim2.new(1, -20, 0, 6)
        sliderBg.Position = UDim2.new(0, 10, 0, 26)
        sliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        sliderBg.ZIndex = 4
        Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)

        local sliderFill = Instance.new("Frame", sliderBg)
        sliderFill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
        sliderFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        sliderFill.ZIndex = 5
        Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

        local draggingSlider = false
        local function updateInput(input)
            local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * pos)
            sliderFill.Size = UDim2.new(pos, 0, 1, 0)
            title.Text = titleText .. ": " .. tostring(val)
            pcall(callback, val)
        end

        sliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
                updateInput(input)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateInput(input)
            end
        end)
    end

    function tabObj:Dropdown(data)
        local titleText = data.Title or "Dropdown"
        local values = data.Values or {}
        local currentVal = data.Value or values[1] or "None"
        local callback = data.Callback or function() end
        local idx = 1
        for i, v in ipairs(values) do
            if v == currentVal then idx = i break end
        end

        local btn = Instance.new("TextButton", page)
        btn.Size = UDim2.new(1, -6, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(12, 12, 15)
        btn.BackgroundTransparency = 0.25
        btn.Text = "  " .. titleText .. ": " .. tostring(currentVal)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 10
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.ZIndex = 3
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = Color3.fromRGB(80, 80, 80)
        stroke.Thickness = 0.8

        btn.MouseButton1Click:Connect(function()
            if #values == 0 then return end
            idx = idx + 1
            if idx > #values then idx = 1 end
            local choice = values[idx]
            btn.Text = "  " .. titleText .. ": " .. tostring(choice)
            pcall(callback, choice)
        end)

        local dropdownObj = {}
        function dropdownObj:Refresh(newValues)
            values = newValues or {}
            idx = 1
            currentVal = values[1] or "None"
            btn.Text = "  " .. titleText .. ": " .. tostring(currentVal)
        end
        return dropdownObj
    end

    return tabObj
end

function MiiseryUI:Destroy()
    pcall(function()
        self.ScreenGui:Destroy()
    end)
end

return MiiseryUI
