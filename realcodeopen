local function safeTweenTo(targetCFrame, speed)
    local myRoot = humanoidRootPart
    if not myRoot then return end
    local dist = (targetCFrame.Position - myRoot.Position).Magnitude
    local timeDuration = math.clamp(dist / speed, 0.1, 10)
    if activeChestTween then activeChestTween:Cancel() end
    activeChestTween = TweenService:Create(myRoot, TweenInfo.new(timeDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
        CFrame = targetCFrame
    })
    activeChestTween:Play()
    activeChestTween.Completed:Wait()
end

