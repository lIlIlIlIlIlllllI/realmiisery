-- =========================================================================
-- RAW CONTROLLER METHODS
-- =========================================================================

function MiiseryUI:ToggleVisibility(state)
    self.IsVisible = state ~= nil and state or not self.IsVisible
    if self.IsMinimized then
        self.ScreenGui.Enabled = true
        self.ToggleButton.Visible = self.IsVisible
        self.MainFrame.Visible = false
    else
        self.ScreenGui.Enabled = self.IsVisible
        self.MainFrame.Visible = self.IsVisible
        self.ToggleButton.Visible = false
    end
end

function MiiseryUI:Minimize()
    if self.IsMinimized then return end
    self.IsMinimized = true
    TweenService:Create(self.MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = self.MainFrame.Position + UDim2.new(0, 272, 0, 180)
    }):Play()
    task.wait(0.2)
    self.MainFrame.Visible = false
    self.ToggleButton.Size = UDim2.new(0, 0, 0, 36)
    self.ToggleButton.Visible = true
    TweenService:Create(self.ToggleButton, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 175, 0, 36)
    }):Play()
end

function MiiseryUI:Restore()
    if not self.IsMinimized then return end
    TweenService:Create(self.ToggleButton, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 36)
    }):Play()
    task.wait(0.15)
    self.ToggleButton.Visible = false
    self.MainFrame.Size = UDim2.new(0, 0, 0, 0)
    self.MainFrame.Visible = true
    TweenService:Create(self.MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = self.Config.Size,
        Position = self.Config.Position
    }):Play()
    task.wait(0.3)
    self.IsMinimized = false
end

function MiiseryUI:ToggleExpand()
    self.IsExpanded = not self.IsExpanded
    local targetSize = self.IsExpanded and self.Config.ExpandedSize or self.Config.Size
    local targetPos = self.IsExpanded and UDim2.new(0.5, -340, 0.5, -205) or self.Config.Position
    TweenService:Create(self.MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = targetSize,
        Position = targetPos
    }):Play()
end

function MiiseryUI:SetAccentColor(color)
    self.Config.AccentColor = color
    for _, stroke in ipairs(self.UIStrokes) do
        if stroke and stroke.Parent then
            stroke.Color = color
        end
    end
end

function MiiseryUI:SetBackground(assetId)
    self.Config.AssetID = tostring(assetId)
    local formattedUri = "rbxassetid://" .. self.Config.AssetID
    pcall(function()
        self.BackgroundImage.Image = ""
        task.wait(0.02)
        self.BackgroundImage.Image = formattedUri
        self.SidebarLogo.Image = formattedUri
        self.BadgeLogo.Image = formattedUri
    end)
end

function MiiseryUI:SetTitle(title, subtitle)
    if title then
        self.Config.Title = title
        self.HubTitleLabel.Text = title
    end
    if subtitle then
        self.Config.Subtitle = subtitle
        self.AuthorSubLabel.Text = subtitle
    end
end

