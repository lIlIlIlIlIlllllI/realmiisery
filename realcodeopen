-- Animación Kamui con giro exacto sobre su centro total
local function AnimateUI(open)
    if animating then return end
    animating = true
    playKamuiAudio()

    KamuiRing.Visible = true
    KamuiRing.Size = UDim2.new(0, 0, 0, 0)
    KamuiRing.Rotation = 0
    KamuiRing.ImageTransparency = 0

    local spinConnection
    local startTime = tick()
    spinConnection = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local currentSpeed = (elapsed <= 0.8) and 6 else 50
        KamuiRing.Rotation = KamuiRing.Rotation + currentSpeed
        if open then
            MainContainer.Rotation = (1 - math.clamp(elapsed/1.5, 0, 1)) * 360
        else
            MainContainer.Rotation = math.clamp(elapsed/1.5, 0, 1) * -360
        end
        if elapsed >= 3 then
            if spinConnection then spinConnection:Disconnect() end
        end
    end)

    if open then
        MainContainer.Visible = true
        MainContainer.Size = UDim2.new(0, 0, 0, 0)
        MainContainer.Position = initialExecutionPos
        
        TweenService:Create(KamuiRing, TweenInfo.new(1.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 580, 0, 580)
        }):Play()

        TweenService:Create(MainContainer, TweenInfo.new(1.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = normalSize,
            Rotation = 0
        }):Play()
    else
        TweenService:Create(KamuiRing, TweenInfo.new(1.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 580, 0, 580)
        }):Play()

        TweenService:Create(MainContainer, TweenInfo.new(1.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            Rotation = -360
        }):Play()
    end

    task.wait(1.5)

    local fadeOut = TweenService:Create(KamuiRing, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        ImageTransparency = 1
    })
    fadeOut:Play()
    fadeOut.Completed:Wait()

    KamuiRing.Visible = false
    if spinConnection then spinConnection:Disconnect() end
    MainContainer.Rotation = 0

    if not open then
        MainContainer.Visible = false
    end

    isOpen = open
    animating = false
end

