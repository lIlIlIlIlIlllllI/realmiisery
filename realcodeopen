local BlacklistTab = HubLibrary:CreateTab("Blacklist")
local function addBlToggle(cat, key)
    local ck = "BL_" .. cat .. "_" .. key
    CreateToggle(BlacklistTab, cat .. ": Blacklist " .. key, Config[ck] == true, function(v)
        Config[ck] = v
        SilentAimModule:SetBlacklistKey(cat, key, v)
    end)
end
for _, key in ipairs({"Z", "X", "C"}) do addBlToggle("Melee", key) end
for _, key in ipairs({"Z", "X", "C", "V", "F", "TAP"}) do addBlToggle("Fruit", key) end
for _, key in ipairs({"Z", "X"}) do addBlToggle("Sword", key) end
for _, key in ipairs({"Z", "X"}) do addBlToggle("Gun", key) end

