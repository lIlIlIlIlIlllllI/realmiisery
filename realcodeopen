local function getCurrentIsland()
    local myRoot = humanoidRootPart
    if not myRoot then return nil end
    local islands = getIslandsForCurrentSea()
    local currentIsland = nil
    local shortestDist = math.huge
    for i = 1, #islands do
        local island = islands[i]
        local cf = island.GetCFrame()
        if cf then
            local dist = (cf.Position - myRoot.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                currentIsland = island
            end
        end
    end
    if shortestDist <= 500 then return currentIsland end
    return nil
end

local function getNearestIsland(excludeIslandName)
    local myRoot = humanoidRootPart
    if not myRoot then return nil end
    local islands = getIslandsForCurrentSea()
    local nearestIsland = nil
    local shortestDist = math.huge
    for i = 1, #islands do
        local island = islands[i]
        if not excludeIslandName or island.Name ~= excludeIslandName then
            local cf = island.GetCFrame()
            if cf then
                local dist = (cf.Position - myRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearestIsland = island
                end
            end
        end
    end
    if not nearestIsland and excludeIslandName then return getNearestIsland(nil) end
    return nearestIsland
end

