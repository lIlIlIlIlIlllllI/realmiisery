local function MakeSmoothDraggable(guiObject)
    local dragging = false
    local dragInput, mousePos, framePos

    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            mousePos = input.Position
            framePos = guiObject.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - mousePos
            local newX = framePos.X.Offset + delta.X
            local newY = framePos.Y.Offset + delta.Y

            local viewport = ScreenGui.AbsoluteSize
            local objSize = guiObject.AbsoluteSize

            newX = math.clamp(newX, 0, viewport.X - objSize.X)
            newY = math.clamp(newY, 0, viewport.Y - objSize.Y)

            guiObject.Position = UDim2.new(0, newX, 0, newY)
        end
    end)
end

local function MakeLimitedDraggable(guiObject, handle, maxDistance)
    local dragging = false
    local dragInput, mousePos, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            mousePos = input.Position
            startPos = guiObject.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - mousePos
            local currentX = startPos.X.Offset + delta.X
            local currentY = startPos.Y.Offset + delta.Y

            local viewport = ScreenGui.AbsoluteSize
            local objSize = guiObject.AbsoluteSize

            local defaultX = (viewport.X / 2) - (objSize.X / 2)
            local defaultY = (viewport.Y / 2) - (objSize.Y / 2)

            local clampedX = math.clamp(currentX, defaultX - maxDistance, defaultX + maxDistance)
            local clampedY = math.clamp(currentY, defaultY - maxDistance, defaultY + maxDistance)

            guiObject.Position = UDim2.new(0, clampedX, 0, clampedY)
        end
    end)
end

