    Title = "Change Logo (Cycle)",
    Callback = function()
        -- Cicla entre logos al hacer click
        local keys = logoNames
        for i, name in ipairs(keys) do
            if assetMap[name] == Config.CustomAssetID then
                local nextIdx = (i % #keys) + 1
