local function playKamuiAudio()
    pcall(function()
        for _, s in ipairs(SoundService:GetDescendants()) do
            if s:IsA("Sound") and s ~= KamuiSound then
                pcall(function() s:Stop() end)
            end
        end
        KamuiSound.TimePosition = 0
        KamuiSound:Play()
    end)
end

